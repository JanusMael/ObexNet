<Project Sdk="Microsoft.NET.Sdk">

    <!-- TargetFramework, Nullable, ImplicitUsings, TreatWarningsAsErrors, the debug-symbol policy
         and the AutoVersioning generator are inherited from Directory.Build.props at the repo root. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>Bennewitz.Ninja.ObexNet</RootNamespace>
        <!-- Essential: Required for pointer arithmetic and P/Invoke pointers -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- One AnyCPU binary serves both x64 and ARM64 hosts (see README "Extended Features");
             AssemblyUtility.GetSupportedArchitectureOrThrow rejects 32-bit processes at startup. -->
        <PlatformTarget>AnyCPU</PlatformTarget>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>1701;1702;CS1591</NoWarn>
    </PropertyGroup>

    <!--
      DISTRIBUTION & PUBLISHING CONFIGURATION
      Produces a self-contained, single-file, trimmed ObexNet.exe per RID — the analysis machine
      does NOT need .NET installed. publish/publish.ps1 is the canonical entry point
      (`dotnet publish -c Release -r win-x64` produces the same output).

      Gated on _IsPublishing (set by `dotnet publish`) rather than on Configuration=Release so a
      plain `dotnet build -c Release` stays framework-dependent and RID-less: SelfContained=true on
      its own makes the SDK auto-pick the host RID and move the output under
      bin/Release/net10.0/<rid>/, which would break the test fixture's
      ObexNet/bin/<Config>/<tfm>/ObexNet.exe lookup.
    -->
    <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
        <SelfContained>true</SelfContained>
        <PublishSingleFile>true</PublishSingleFile>
        <PublishTrimmed>true</PublishTrimmed>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    </PropertyGroup>

</Project>
