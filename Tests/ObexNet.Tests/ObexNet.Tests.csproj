<Project Sdk="Microsoft.NET.Sdk">

    <!-- TargetFramework, Nullable, ImplicitUsings, TreatWarningsAsErrors and the AutoVersioning
         generator are inherited from Directory.Build.props at the repo root. -->
    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <RootNamespace>Bennewitz.Ninja.ObexNet.Tests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
        <PackageReference Include="MSTest.TestAdapter" Version="4.5.1" />
        <PackageReference Include="MSTest.TestFramework" Version="4.5.1" />
        <PackageReference Include="coverlet.collector" Version="10.0.1">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\ObexNet\ObexNet.csproj" />
        <ProjectReference Include="..\ObexNet.TestDll\ObexNet.TestDll.csproj" />
    </ItemGroup>

    <!-- Reference the main project and the TestDll -->

</Project>